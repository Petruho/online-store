<?xml version="1.0"?>
<ruleset name="psr12">
    <description>code style</description>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg value="p"/>
    <arg value="n"/>
    <arg value="s"/>
    <arg name="extensions" value="php"/>
    <arg name="ignore" value="vendor,storage,bootstrap/cache"/>
    <config name="ignore_warnings_on_exit" value="1"/>

    <!-- Какие директории проверять -->
    <file>app</file>
    <file>tests</file>
    <file>database</file>
    <file>routes</file>
    <file>config</file>
    <file>bootstrap</file>

    <rule ref="PSR12">
        <exclude name="PSR1.Methods.CamelCapsMethodName"/>
    </rule>

    <!-- Игнорировать camelCaps для тестовых методов -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
</ruleset>
